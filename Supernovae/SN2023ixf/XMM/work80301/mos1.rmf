  = 'CHANNEL '           / The name of this column                        TFORM1  = 'I       '           / data format of field: 2-byte INTEGER           TTYPE2  = 'E_MIN   '           / The name of this column                        TFORM2  = 'E       '           / data format of field: 4-byte REAL              TUNIT2  = 'keV     '           / physical unit of field                         TTYPE3  = 'E_MAX   '           / The name of this column                        TFORM3  = 'E       '           / data format of field: 4-byte REAL              TUNIT3  = 'keV     '           / physical unit of field                         EXTNAME = 'EBOUNDS '           / The name of this table                         TELESCOP= 'XMM     '           / mission/satellite name                         INSTRUME= 'EMOS1   '           / instrument/detector name                       FILTER  = 'Medium  '           / filter in use                                  RMFVERSN= '1992a   '           / OGIP classification of FITS format             CHANTYPE= 'PI      '           / Detector Channel Type in use (PHA or PI        DETCHANS=                 2400 / total number of detector channels              HDUCLASS= 'OGIP    '           / Format conforms to OGIP standard               HDUCLAS1= 'RESPONSE'           / dataset relates to spectral response           HDUCLAS2= 'EBOUNDS '           / dataset is a spectral response matrix          HDUCLAS3= 'REDIST  '           / photon redistribution matrix                   HDUVERS = '1.3.0   '           / Version of format (OGIP memo CAL/GEN/92-002a)  HDUVERS1= '1.3.0   '           / Obsolete - included for backwards compatibilityTLMIN1  =                    0 / Minimum value legally allowed in FCHAN column  TLMAX1  =                 2399 / Minimum value legally allowed in FCHAN column  END                                                                                                                                                                   