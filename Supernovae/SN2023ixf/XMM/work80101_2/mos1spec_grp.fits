       2 / 2-dimensional binary table                     NAXIS1  =                   16 / width of table in bytes                        NAXIS2  =                    4 / number of rows in table                        PCOUNT  =                    0 / size of special data area                      GCOUNT  =                    1 / one data group (required keyword)              TFIELDS =                    2 / number of fields in each row                   TTYPE1  = 'START   '           / lower GTI boundary                             TFORM1  = 'D       '           / data format of field: 8-byte DOUBLE            TUNIT1  = 's       '           / physical unit of field                         TTYPE2  = 'STOP    '           / upper GTI boundary                             TFORM2  = 'D       '           / data format of field: 8-byte DOUBLE            TUNIT2  = 's       '           / physical unit of field                         EXTNAME = 'GTI00302'           / The name of this table                         CCDID   =                    5 / CCD ID                                         HDUCLASS= 'OGIP    '           / format conforms to OGIP standard               HDUCLAS1= 'GTI     '           / table contains Good Time Intervals             HDUCLAS2= 'STANDARD'           / standard Good Time Interval table              ONTIME  = 1.16326990251541E+04 / [s] sum of all Good Time Intervals             TSTART  = 8.03482090863922E+08 / [s] Lower bound of first GTI                   TSTOP   = 8.03493903562948E+08 / [s] Uppler bound of last GTI                   TIMEUNIT= 's       '           / All times in s unless specified otherwise      TIMESYS = 'TT      '           / XMM time will be TT (Terrestrial Time)         MJDREF  = 5.08140000000000E+04 / [d] 1998-01-01T00:00:00 (TT) expressed in MJD  TIMEREF = 'LOCAL   '           / Reference location of photon arrival times     TASSIGN = 'SATELLITE'          / Location of time assignment                    TIMEZERO= 0.0000000000